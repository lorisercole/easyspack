[28.57500, "m", "Install quantum-espresso"]
[28.57678, "o", "  To use this demo Spack installation, run:\r\n\r\n    export SPACK_USER_CONFIG_PATH=/home/lercole/demo_spood\r\n    export SPACK_USER_CACHE_PATH=/home/lercole/demo_spood/cache\r\n\r\n  Spack config directory:   /home/lercole/demo_spood\"\r\n  Spack install directory:  /home/lercole/demo_spood/opt\"\r\n  Spack modules directory:  /home/lercole/demo_spood/modules\"\r\n\r\n"]
[30.579237, "o", "\u001b[1;38m============  Demo Commands  ============\u001b[0m\r\n\u001b[1;38m 1. List configured external packages:\u001b[0m\r\n   $ spack find -p --show-configured-externals\r\n\r\n"]
