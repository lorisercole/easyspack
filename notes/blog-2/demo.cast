[13.987124, "o", "\u001b[1;38m============  Spood Demo Setup  ============\u001b[0m\r\n\u001b[1;38m • Demo directory:\u001b[0m\r\n     /home/lercole/demo_spood\r\n\u001b[1;38m • Configuring Spack environment variables...\u001b[0m\r\n   - SPACK_USER_CONFIG_PATH=/home/lercole/demo_spood\r\n   - SPACK_USER_CACHE_PATH=/home/lercole/demo_spood/cache\r\n"]
[13.990657, "o", "\u001b[1;38m • Copying/generating Spack configuration files...\u001b[0m\r\n"]
[13.992181, "o", "   - /home/lercole/src/spood/share/spack_config/concretizer.yaml -->  /home/lercole/demo_spood/concretizer.yaml\r\n"]
[13.993476, "o", "   - /home/lercole/src/spood/share/spack_config/config.yaml.tpl  -->  /home/lercole/demo_spood/config.yaml\r\n"]
[13.994207, "o", "   - /home/lercole/src/spood/share/spack_config/modules.yaml.tpl -->  /home/lercole/demo_spood/modules.yaml\r\n"]
[13.994224, "o", "\u001b[1;38m • Creating packages.yaml from externals_nocompat.yaml...\u001b[0m\r\n"]
[13.995003, "o", "   - /home/lercole/src/spood/examples/ext_install/externals_nocompat.yaml  -->  /home/lercole/demo_spood/packages.yaml\r\n"]
